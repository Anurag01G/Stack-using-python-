#include<iostream>
#define MAX 5
using namespace std;

class Stack
{
  public : 
  int A[MAX];
  int top;
  Stack()
  {
    top = -1;
  }
  
  void push(int value)
  {
    if(top == MAX-1)
    {
      cout<<" ERROR : STACK IS OVERFLOW "<<endl;
    }
    else
    {
      top ++;
      A[top] = value;
      cout<<value<<" is pushed into the STACK."<<endl;
    }
  }
  
  void pop()
  {
    if(top == -1)
    {
      cout<<"ERROR : STACK IS UNDERFLOW"<<endl;
    }
    else 
    {
      cout<<A[top]<<" is poped form the STACK."<<endl;
      top--;
    }
  }
  
  void display()
  {
    if(top == -1)
    {
      cout<<" STACK IS EMPTY "<<endl;
    }
    else
    {
      cout<<"\nThe stack elements are : \n";
      for(int i=top;i>=0;i--)
      {
        cout<<A[i]<<endl<<"\n";
      }
    }
  }
};

int main()
{
  Stack s;
  s.push(10);
  s.push(20);
  s.push(30);
  s.display();
  s.pop();
  s.pop();
  s.display();
  
  return 0;
}
